# Opsætning til BigWigsMods/packager (se .github/workflows/release.yml).
package-as: GuildCrafters

# Release notes på CurseForge og GitHub Releases er CHANGELOG.md, skrevet til spillere. Uden denne
# linje laver packageren dem af commit-beskederne (alle commits siden sidste tag, inkl. interne).
# Filen skal starte med "# GuildCrafters <version>"; simulatoren (scenarie 16) fejler ellers.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Addonen ligger i undermappen GuildCrafters/ – flyt den op i pakkens rod,
# så zip'en bliver GuildCrafters/GuildCrafters.toc.
move-folders:
  GuildCrafters/GuildCrafters: GuildCrafters

# Alt uden for addon-mappen skal ikke med i pakken.
ignore:
  - tools
  - dist
  - assets
  - README.md
  - SPEC.md
  - CLAUDE.md
  # Testudgavens .toc (se README "Udvikling") hører kun hjemme i repoet.
  - GuildCrafters/GuildCraftersTest.toc
